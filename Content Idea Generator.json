    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet raw = '';\nif (j.output && j.output[0] && j.output[0].content && j.output[0].content[0]) {\n  raw = j.output[0].content[0].text || '';\n} else {\n  raw = j.text || '';\n}\nif (!raw) raw = 'عذراً، لم أتمكن من تجهيز الرد. حاول مرة أخرى.';\n\nfunction formatLine(line) {\n  let s = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  s = s.replace(/^#{1,6}\\s+(.+)$/, '**$1**');\n  s = s.replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\n  s = s.replace(/\\*\\*/g, '');\n  return s;\n}\n\nconst MAX = 3800;\nconst lines = raw.split('\\n');\nconst chunks = [];\nlet current = '';\nfor (const line of lines) {\n  const f = formatLine(line);\n  if (f.length > MAX) {\n    if (current) { chunks.push(current); current = ''; }\n    for (let i = 0; i < f.length; i += MAX) chunks.push(f.slice(i, i + MAX));\n    continue;\n  }\n  if ((current + '\\n' + f).length > MAX) {\n    chunks.push(current);\n    current = f;\n  } else {\n    current = current ? current + '\\n' + f : f;\n  }\n}\nif (current.trim()) chunks.push(current);\n\nreturn chunks.map((text, i) => ({ json: { text: text, part: i + 1, total: chunks.length } }));"
      },
