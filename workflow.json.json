        "responses": {
          "values": [
            {
              "content": "=طلب الطالب الخاص (إن وجد):\n{{ $('Prepare Lesson Content').item.json.userRequest || 'لا يوجد طلب خاص' }}\n\nمحتوى الدرس:\n{{ $('Prepare Lesson Content').item.json.lessonContent }}"
            }
